CREATE TABLE SeenFact (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    shortText TEXT NOT NULL,
    fullText TEXT NOT NULL,
    longText TEXT NOT NULL,
    sourceUrl TEXT NOT NULL,
    topic TEXT NOT NULL,
    reaction TEXT NOT NULL DEFAULT 'NONE',
    shownDateEpochDay INTEGER NOT NULL
);

CREATE INDEX seenFact_shownDate ON SeenFact(shownDateEpochDay);

CREATE TABLE AvoidedTopic (
    topic TEXT NOT NULL PRIMARY KEY
);

insertFact:
INSERT OR IGNORE INTO SeenFact(id, title, shortText, fullText, longText, sourceUrl, topic, shownDateEpochDay)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllIds:
SELECT id FROM SeenFact;

selectRecent:
SELECT * FROM SeenFact
WHERE shownDateEpochDay >= :sinceEpochDay
ORDER BY shownDateEpochDay DESC, rowid DESC;

selectFavorites:
SELECT * FROM SeenFact
WHERE reaction = 'LIKE'
ORDER BY shownDateEpochDay DESC, rowid DESC;

-- O gün en son gösterilen bilgi (rowid eklenme sırasını verir).
selectLatestForDay:
SELECT * FROM SeenFact
WHERE shownDateEpochDay = :epochDay
ORDER BY rowid DESC
LIMIT 1;

selectById:
SELECT * FROM SeenFact WHERE id = ?;

deleteOlderThan:
DELETE FROM SeenFact WHERE shownDateEpochDay < :epochDay;

updateReaction:
UPDATE SeenFact SET reaction = :reaction WHERE id = :id;

addAvoidedTopic:
INSERT OR IGNORE INTO AvoidedTopic(topic) VALUES (?);

removeAvoidedTopic:
DELETE FROM AvoidedTopic WHERE topic = ?;

selectAvoidedTopics:
SELECT topic FROM AvoidedTopic;
